    {
      "refdes": "U1",
      "kind": "Custom",
      "value": "CH340G",
      "pos": [
        90,
        30
      ],
      "rot": 0,
      "footprint": "SOIC-16_3.9x9.9_P1.27",
      "custom": {
        "name": "CH340G",
        "prefix": "U",
        "pins": [
          {
            "number": "15",
            "name": "R232",
            "side": "left"
          },
          {
            "number": "5",
            "name": "UD+",
