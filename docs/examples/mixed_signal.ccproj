          "prefix": "U",
          "ratings": {
            "rows": [
              {
                "name": "利得帯域幅積",
                "value": "1MHz (代表)"
              },
              {
                "name": "入力オフセット電圧",
                "value": "2mV (代表)"
              },
              {
