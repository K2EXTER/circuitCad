      ],
      "rot": 0,
      "footprint": "DIP-18_W7.62",
      "custom": {
        "name": "ULN2803A",
        "prefix": "U",
        "pins": [
          {
            "number": "1",
            "name": "IN1",
            "side": "left"
          },
          {
