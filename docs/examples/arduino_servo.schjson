  "sketches": {
    "U1": "// A0 のボリュームを回すと、D9 のサーボが同じだけ回ります (Servo ライブラリ)\n#include <Servo.h>\n\nServo servo;\n\nvoid setup() {\n  Serial.begin(9600);\n  servo.attach(9);\n}\n\nvoid loop() {\n  int angle = map(analogRead(A0), 0, 1023, 0, 180);\n  servo.write(angle);   // 0〜180 度\n  Serial.println(angle);\n  delay(100);\n}\n"
  },
