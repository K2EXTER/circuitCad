  "sketches": {
    "U1": "// D22・D24・D26・D28 の LED を順に点ける流れる光。A8 のボリュームで速さが変わります\nvoid setup() {\n  Serial.begin(9600);\n  for (int k = 0; k < 4; k++) {\n    pinMode(22 + 2 * k, OUTPUT);\n  }\n}\n\nvoid loop() {\n  for (int k = 0; k < 4; k++) {\n    int wait = map(analogRead(A8), 0, 1023, 50, 500);\n    digitalWrite(22 + 2 * k, HIGH);\n    delay(wait);\n    digitalWrite(22 + 2 * k, LOW);\n  }\n  Serial.println(analogRead(A8));\n}\n"
  },
