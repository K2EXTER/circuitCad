  "layout_version": 1,
  "sketches": {
    "U1": "// ATtiny85 の PB1 の LED を点滅させます。A1 (PB2) のボリュームで速さが変わります\n// ATtiny85 には USB が無いので、8 番 (VCC) と 4 番 (GND) に電源をつなぎます\nvoid setup() {\n  pinMode(1, OUTPUT);\n}\n\nvoid loop() {\n  int wait = map(analogRead(A1), 0, 1023, 50, 500);\n  digitalWrite(1, HIGH);\n  delay(wait);\n  digitalWrite(1, LOW);\n  delay(wait);\n}\n"
  },
