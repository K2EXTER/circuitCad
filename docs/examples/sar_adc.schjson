    {
      "custom": {
        "name": "ADC4_SAR",
        "pins": [
          {
            "name": "AIN",
            "number": "1",
            "side": "left"
          },
          {
            "name": "CLK",
            "number": "2",
            "side": "left"
          },
          {
            "name": "START",
            "number": "3",
            "side": "left"
          },
          {
            "name": "EOC",
            "number": "4",
            "side": "right"
          },
          {
            "name": "GND",
            "number": "5",
            "side": "bottom"
          },
          {
            "name": "D0",
            "number": "6",
            "side": "right"
          },
          {
            "name": "D1",
            "number": "7",
            "side": "right"
          },
          {
            "name": "D2",
            "number": "8",
            "side": "right"
          },
          {
            "name": "D3",
            "number": "9",
            "side": "right"
          },
