      "value": "74HC4040",
      "pos": [
        32,
        22
      ],
      "rot": 0,
      "footprint": "DIP-16_W7.62",
      "custom": {
        "name": "74HC4040",
        "prefix": "U",
        "pins": [
          {
            "number": "1",
            "name": "Q12",
            "side": "right"
          },
          {
            "number": "2",
            "name": "Q6",
