# Two NPN transistors (2N3904, SOT-23) biased for about 5 mA, each with 330 ohm to 12 V on its collector.
# Q1 has its base held at a fixed voltage by a divider and no emitter resistor: as it warms, its base-emitter voltage
# needs about 2 mV less per degree, so the same base voltage pushes more current, which warms it more.
# Q2 has a 100 ohm emitter resistor: more current raises the emitter voltage and takes back the base drive.
# The "自己発熱" (heat) run shows Q1's current more than doubling and Q2's moving a few percent.
# Build: cargo run -p cli -- docs/examples/bjt_self_heat.ccad
new
add V 12 as=V1
add NPN as=Q1
add NPN as=Q2
add R 10k as=R1
add R 750 as=R2
add R 330 as=R3
add R 10k as=R4
add R 1.3k as=R5
add R 330 as=R6
add R 100 as=R7
net VCC V1.+ R1.1 R3.1 R4.1 R6.1
net B1 R1.2 R2.1 Q1.B
net C1 R3.2 Q1.C
net B2 R4.2 R5.1 Q2.B
net C2 R6.2 Q2.C
net E2 Q2.E R7.1
net GND V1.- R2.2 Q1.E R5.2 R7.2
erc
dc
heat
save docs/examples/bjt_self_heat.schjson
