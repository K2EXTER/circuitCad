            "name": "GND",
            "number": "4",
            "side": "bottom"
          },
          {
            "kind": "passive",
            "name": "BST",
            "number": "6",
            "side": "right"
          },
          {
            "kind": "power_out",
            "name": "SW",
            "number": "5",
