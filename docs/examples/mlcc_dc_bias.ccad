# The same 10 uF ceramic capacitor (Murata GRM188R61C106MA73, X5R 16 V, 0603) in two RC low-pass filters: one at 0 V DC, one at
# 12 V DC. Under the DC bias it keeps only about a seventh of its capacitance, so its cutoff moves up about seven times.
# The resistors come first (pin 1 on the output) so that the AC analysis shows OUT0 and OUT12 when it opens.
# Build: cargo run -p cli -- docs/examples/mlcc_dc_bias.ccad
new
add R 100 as=R1
add R 100 as=R2
add GRM188R61C106MA73 as=C1
add GRM188R61C106MA73 as=C2
add V 0 as=V1
value V1 "0 AC 1"
add V 12 as=V2
value V2 "12 AC 1"
net OUT0 R1.1 C1.1
net OUT12 R2.1 C2.1
net IN0 V1.+ R1.2
net IN12 V2.+ R2.2
net GND V1.- C1.2 V2.- C2.2
erc
ac 10 100k ppd=20 probe=V(OUT0)
ac 10 100k ppd=20 probe=V(OUT12)
save docs/examples/mlcc_dc_bias.schjson
